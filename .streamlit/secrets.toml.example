# Triage secrets — copy this file to `.streamlit/secrets.toml` and fill in real
# values. On Streamlit Community Cloud, paste the same keys into the app's
# Settings → Secrets panel instead of committing a file.
#
# secrets.toml is gitignored: never commit real credentials.

# Anthropic API key used by the agent loop.
ANTHROPIC_API_KEY = "sk-ant-..."

# ── Authentication ──────────────────────────────────────────────────────────
# Choose ONE of the two shapes below.

# Option A — one shared password for the whole deployment:
app_password = "change-me"

# Option B — per-user credentials (comment out app_password above to use this):
# [passwords]
# sarah    = "sarahs-password"
# director = "directors-password"
