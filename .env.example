# Copy to `.env` and fill in. `.env` is gitignored.

# Anthropic API key for the agent (Claude Sonnet).
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret for the FastAPI wrapper (api/). The Next.js frontend sends this
# in the `X-API-Key` header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The SAME value must be set as TRIAGE_API_SECRET in triage-web/.env.local.
TRIAGE_API_SECRET=change-me
